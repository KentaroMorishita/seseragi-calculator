  pure fn rawTanh value: Float -> Float = "tanh"
  pure fn rawEuler unit: Unit -> Float = "euler"
  pure fn rawPi unit: Unit -> Float = "pi"
}

let addFn: Float -> Float -> Float = rawAdd
let subtractFn: Float -> Float -> Float = rawSubtract
let multiplyFn: Float -> Float -> Float = rawMultiply
let divideFn: Float -> Float -> Float = rawDivide
let powerFn: Float -> Float -> Float = rawPower
