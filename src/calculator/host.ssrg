foreign "typescript" from "../../host/math.mjs" {
  pure fn rawAdd left: Float -> right: Float -> Float = "add"
  pure fn rawSubtract left: Float -> right: Float -> Float = "subtract"
  pure fn rawMultiply left: Float -> right: Float -> Float = "multiply"
  pure fn rawDivide left: Float -> right: Float -> Float = "divide"
