import * as arrays from "std/array"
import * as floats from "std/float"
import * as entry from "./entry"
import * as math from "./math"
import {
  AngleUnit,
  BinaryOperator,
  CalculatorAction,
  CalculatorMode,
  CalculatorState,
  Display,
  HistoryEntry,
  InputPhase,
  Overlay,
  UnaryOperator,
} from "./model"

fn resetCalculation state: CalculatorState -> CalculatorState =
  CalculatorState {
    ...state,
    overlay: NoOverlay,
    phase: Editing,
    display: Entry [],
    caption: "",
    accumulator: Nothing,
    pending: Nothing,
  }

fn remember expression: String
  -> result: Float
  -> state: CalculatorState
  -> CalculatorState = {
  let rendered: String = floats.format result
  let item: HistoryEntry = HistoryEntry {
    expression,
    result: rendered,
    value: result,
  }
  let latest: Array<HistoryEntry> = arrays.append state.history [item]
  CalculatorState {
    ...state,
    history: arrays.take 30 latest,
  }
}

fn inputDigit digit: Int -> state: CalculatorState -> CalculatorState =
  match state.phase {
    Editing ->
      CalculatorState {
        ...state,
        display: entry.appendDigit digit state.display,
      }
    AwaitingOperand ->
      CalculatorState {
        ...state,
        phase: Editing,
        display: entry.startDigit digit,
      }
    ShowingResult ->
      CalculatorState {
        ...state,
        phase: Editing,
        display: entry.startDigit digit,
        caption: "",
        accumulator: Nothing,
        pending: Nothing,
      }
  }

fn inputDecimal state: CalculatorState -> CalculatorState =
  match state.phase {
    Editing ->
      CalculatorState {
        ...state,
        display: entry.appendDecimal state.display,
      }
    AwaitingOperand ->
      CalculatorState {
        ...state,
        phase: Editing,
        display: entry.startDecimal (),
      }
    ShowingResult ->
      CalculatorState {
        ...state,
        phase: Editing,
        display: entry.startDecimal (),
        caption: "",
        accumulator: Nothing,
        pending: Nothing,
      }
  }

fn deleteDigit state: CalculatorState -> CalculatorState =
  match state.phase {
    Editing -> CalculatorState { ...state, display: entry.backspace state.display }
    AwaitingOperand -> state
    ShowingResult -> state
  }

fn toggleSign state: CalculatorState -> CalculatorState = {
  let current: Float = entry.displayValue state.display
  match state.phase {
    AwaitingOperand ->
      CalculatorState {
        ...state,
        phase: Editing,
        display: Value (0.0 - current),
      }
    Editing -> CalculatorState { ...state, display: Value (0.0 - current) }
    ShowingResult -> CalculatorState { ...state, display: Value (0.0 - current) }
  }
}

fn percent state: CalculatorState -> CalculatorState =
  match state.phase {
    AwaitingOperand -> state
    Editing ->
      CalculatorState {
        ...state,
        display: Value (entry.displayValue state.display / 100.0),
      }
    ShowingResult ->
      CalculatorState {
        ...state,
        display: Value (entry.displayValue state.display / 100.0),
      }
  }

fn startBinary operator: BinaryOperator
  -> state: CalculatorState
  -> CalculatorState = {
  let current: Float = entry.displayValue state.display
  CalculatorState {
    ...state,
    phase: AwaitingOperand,
    accumulator: Just current,
    pending: Just operator,
    caption: `${entry.displayText state.display} ${math.binarySymbol operator}`,
  }
}

fn chainBinary operator: BinaryOperator
  -> previous: BinaryOperator
  -> left: Float
  -> state: CalculatorState
  -> CalculatorState = {
  let right: Float = entry.displayValue state.display
  let result: Float = math.evaluateBinary previous left right
  CalculatorState {
    ...state,
    phase: AwaitingOperand,
    display: Value result,
    accumulator: Just result,
    pending: Just operator,
    caption: `${floats.format result} ${math.binarySymbol operator}`,
  }
}

fn selectBinary operator: BinaryOperator
  -> state: CalculatorState
  -> CalculatorState =
  match state.pending {
    Nothing -> startBinary operator state
    Just previous ->
      match state.accumulator {
        Nothing -> startBinary operator state
        Just left ->
          match state.phase {
            AwaitingOperand ->
              CalculatorState {
                ...state,
                pending: Just operator,
                caption: `${entry.displayText state.display} ${math.binarySymbol operator}`,
              }
            Editing -> chainBinary operator previous left state
            ShowingResult -> startBinary operator state
          }
      }
  }

fn equals state: CalculatorState -> CalculatorState =
  match state.phase {
    AwaitingOperand -> state
    ShowingResult -> state
    Editing ->
      match state.pending {
        Nothing -> state
        Just operator ->
          match state.accumulator {
            Nothing -> state
            Just left -> {
              let right: Float = entry.displayValue state.display
              let result: Float = math.evaluateBinary operator left right
              let expression: String =
                `${floats.format left} ${math.binarySymbol operator} ${entry.displayText state.display}`
              remember expression result
                (CalculatorState {
                  ...state,
                  phase: ShowingResult,
                  display: Value result,
                  caption: expression,
                  accumulator: Nothing,
                  pending: Nothing,
                })
            }
          }
      }
  }

fn unaryOperand state: CalculatorState -> Float =
  match state.phase {
    AwaitingOperand -> 0.0
    Editing -> entry.displayValue state.display
    ShowingResult -> entry.displayValue state.display
  }

fn unaryOperandText state: CalculatorState -> String =
  match state.phase {
    AwaitingOperand -> "0"
    Editing -> entry.displayText state.display
    ShowingResult -> entry.displayText state.display
  }

fn applyUnary operator: UnaryOperator
  -> state: CalculatorState
  -> CalculatorState = {
  let operand: Float = unaryOperand state
  let operandText: String = unaryOperandText state
  let result: Float = math.evaluateUnary state.angleUnit operator operand
  let expression: String = math.unaryExpression operator operandText
  match state.pending {
    Just _ ->
      CalculatorState {
        ...state,
        phase: Editing,
        display: Value result,
        caption: `${state.caption} ${expression}`,
      }
    Nothing ->
      remember expression result
        (CalculatorState {
          ...state,
          phase: ShowingResult,
          display: Value result,
          caption: expression,
          accumulator: Nothing,
          pending: Nothing,
        })
  }
}

fn toggleAngleUnit state: CalculatorState -> CalculatorState =
  CalculatorState {
    ...state,
    angleUnit:
      match state.angleUnit {
        Radians -> Degrees
        Degrees -> Radians
      },
  }

fn recall value: Float -> state: CalculatorState -> CalculatorState =
  CalculatorState {
    ...state,
    overlay: NoOverlay,
    phase: ShowingResult,
    display: Value value,
    caption: "",
    accumulator: Nothing,
    pending: Nothing,
  }

pub fn update action: CalculatorAction
  -> state: CalculatorState
  -> CalculatorState =
  match action {
    Digit digit -> inputDigit digit state
    DecimalPoint -> inputDecimal state
    Backspace -> deleteDigit state
    Clear -> resetCalculation state
    ToggleSign -> toggleSign state
    Percent -> percent state
    SelectBinary operator -> selectBinary operator state
    Equals -> equals state
    ApplyUnary operator -> applyUnary operator state
    ToggleAngleUnit -> toggleAngleUnit state
    OpenModeMenu -> CalculatorState { ...state, overlay: ModeMenu }
    SelectMode mode -> CalculatorState { ...state, mode, overlay: NoOverlay }
    OpenHistory -> CalculatorState { ...state, overlay: HistorySheet }
    CloseOverlay -> CalculatorState { ...state, overlay: NoOverlay }
    RecallHistory value -> recall value state
  }
