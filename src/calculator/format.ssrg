import * as arrays from "std/array"
import * as bytes from "std/bytes"
import * as floats from "std/float"
import * as ints from "std/int"
import * as numbers from "std/number"
import * as texts from "std/text"

fn isDigitCode code: Int -> Bool =
  if code < 48 then False else code <= 57

fn isNumberCode code: Int -> Bool =
  match code {
    43 -> True
    45 -> True
    46 -> True
    101 -> True
    _ -> isDigitCode code
  }

fn isNumberStart code: Int -> Bool =
  if code == 45 then True else isDigitCode code

fn ascii code: Int -> String =
  match code {
    43 -> "+"
    45 -> "-"
    46 -> "."
    48 -> "0"
    49 -> "1"
    50 -> "2"
    51 -> "3"
    52 -> "4"
    53 -> "5"
    54 -> "6"
    55 -> "7"
    56 -> "8"
    57 -> "9"
    101 -> "e"
    _ -> ""
  }

fn countIntegerDigitsAt codes: Array<Int>
  -> index: Int
  -> count: Int
  -> Int =
  if index >= arrays.length codes then
    count
  else
    match arrays.get index codes {
      Nothing -> count
      Just code ->
        if code == 46 then
          count
        else if code == 101 then
          count
        else if isDigitCode code then
          countIntegerDigitsAt codes (index + 1) (count + 1)
        else
          countIntegerDigitsAt codes (index + 1) count
    }

fn renderTail codes: Array<Int> -> index: Int -> String =
  if index >= arrays.length codes then
    ""
  else
    match arrays.get index codes {
      Nothing -> ""
      Just code -> ascii code + renderTail codes (index + 1)
    }

fn separatorFor digitIndex: Int -> remaining: Int -> String =
  if digitIndex <= 0 then
    ""
  else if remaining % 3 == 0 then
    ","
  else
    ""

fn renderGroupedAt codes: Array<Int>
  -> index: Int
  -> integerDigits: Int
  -> digitIndex: Int
  -> String =
  if index >= arrays.length codes then
    ""
  else
    match arrays.get index codes {
      Nothing -> ""
      Just code ->
        if code == 46 then
          ascii code + renderTail codes (index + 1)
        else if code == 101 then
          ascii code + renderTail codes (index + 1)
        else if isDigitCode code then {
          let remaining: Int = integerDigits - digitIndex
          let separator: String = separatorFor digitIndex remaining
          separator + ascii code + renderGroupedAt codes (index + 1) integerDigits (digitIndex + 1)
        }
        else
          ascii code + renderGroupedAt codes (index + 1) integerDigits digitIndex
    }

fn groupFinite raw: String -> String = {
  let codes: Array<Int> = bytes.toInts (texts.encodeUtf8 raw)
  let integerDigits: Int = countIntegerDigitsAt codes 0 0
  renderGroupedAt codes 0 integerDigits 0
}

fn group raw: String -> String =
  if raw == "NaN" then
    raw
  else if raw == "Infinity" then
    raw
  else if raw == "-Infinity" then
    raw
  else
    groupFinite raw

fn magnitude value: Float -> Float =
  match floats.totalCompare value 0.0 {
    Less -> 0.0 - value
    Equal -> value
    Greater -> value
  }

fn displayValue value: Float -> Float = {
  let nearest: Float = floats.roundIntegral numbers.HalfEven value
  let difference: Float = magnitude (value - nearest)
  match floats.totalCompare difference 0.000000001 {
    Less -> nearest
    Equal -> nearest
    Greater -> value
  }
}

fn floatRaw value: Float -> String =
  match floats.toInt numbers.TowardZero value {
    Left _ -> floats.format value
    Right integer ->
      if floats.ieeeEq (floats.fromInt integer) value then
        ints.format integer
      else
        floats.format value
  }

fn utf8Width code: Int -> Int =
  if code <= 127 then 1
  else if code <= 223 then 2
  else if code <= 239 then 3
  else 4

fn decodeSlice raw: bytes.Bytes -> start: Int -> end: Int -> String =
  match bytes.slice start end raw {
    Left _ -> ""
    Right chunk -> texts.decodeUtf8Lossy chunk
  }

fn numberEnd codes: Array<Int> -> index: Int -> Int =
  if index >= arrays.length codes then
    index
  else
    match arrays.get index codes {
      Nothing -> index
      Just code ->
        if isNumberCode code then numberEnd codes (index + 1) else index
    }

fn expressionNumber raw: bytes.Bytes
  -> codes: Array<Int>
  -> index: Int
  -> String = {
  let endIndex: Int = numberEnd codes index
  let token: String = decodeSlice raw index endIndex
  let formatted: String =
    match floats.parse token {
      Left _ -> token
      Right value -> displayFloat value
    }
  formatted + expressionAt raw codes endIndex
}

fn expressionSymbol raw: bytes.Bytes
  -> codes: Array<Int>
  -> index: Int
  -> code: Int
  -> String = {
  let widthValue: Int = utf8Width code
  let endIndex: Int = index + widthValue
  decodeSlice raw index endIndex + expressionAt raw codes endIndex
}

fn expressionAt raw: bytes.Bytes -> codes: Array<Int> -> index: Int -> String =
  if index >= arrays.length codes then
    ""
  else
    match arrays.get index codes {
      Nothing -> ""
      Just code ->
        if isNumberStart code then
          expressionNumber raw codes index
        else
          expressionSymbol raw codes index code
    }

pub fn displayFloat value: Float -> String = {
  let normalized: Float = displayValue value
  group (floatRaw normalized)
}

pub fn displayEntry value: String -> String =
  group value

pub fn expression value: String -> String = {
  let raw: bytes.Bytes = texts.encodeUtf8 value
  let codes: Array<Int> = bytes.toInts raw
  expressionAt raw codes 0
}

pub fn width value: String -> Int =
  bytes.length (texts.encodeUtf8 value)
