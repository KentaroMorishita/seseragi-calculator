import * as arrays from "std/array"
import * as floats from "std/float"
import * as ints from "std/int"

fn containsDecimal parts: Array<String> -> Bool =
  match arrays.find (\part: String -> part == ".") parts {
    Nothing -> False
    Just _ -> True
  }

fn appendText current: String -> part: String -> String =
  current + part

pub fn text parts: Array<String> -> String =
  reduce "" appendText parts

pub fn value parts: Array<String> -> Float =
  match floats.parse (text parts) {
    Left _ -> 0.0
    Right parsed -> parsed
  }

pub fn startDigit digit: Int -> Array<String> =
  [ints.format digit]

pub fn appendDigit digit: Int -> parts: Array<String> -> Array<String> =
  if text parts == "0" then
    startDigit digit
  else if arrays.length parts >= 12 then
    parts
  else
    arrays.append [ints.format digit] parts

pub fn startDecimal -> Array<String> =
  ["0", "."]

pub fn appendDecimal parts: Array<String> -> Array<String> =
  if containsDecimal parts then
    parts
  else
    arrays.append ["."] parts

pub fn backspace parts: Array<String> -> Array<String> =
  if arrays.length parts <= 1 then
    ["0"]
  else
    arrays.take (arrays.length parts - 1) parts
