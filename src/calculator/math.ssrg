import {
  Add,
  AngleUnit,
  BinaryOperator,
  Cosine,
  Cosh,
  Cube,
  CubeRoot,
  Degrees,
  Divide,
  Euler,
  Exponential,
  Factorial,
  Log10,
  Multiply,
  NaturalLog,
  Pi,
  Power,
  Radians,
  Reciprocal,
  Sine,
  Sinh,
  Square,
  SquareRoot,
  Subtract,
  Tangent,
  Tanh,
  TenPower,
  UnaryOperator,
} from "./model"

foreign "typescript" from "../../host/math.mjs" {
  pure fn floatAdd left: Float -> right: Float -> Float = "add"
  pure fn floatSubtract left: Float -> right: Float -> Float = "subtract"
  pure fn floatMultiply left: Float -> right: Float -> Float = "multiply"
  pure fn floatDivide left: Float -> right: Float -> Float = "divide"
  pure fn floatPower base: Float -> exponent: Float -> Float = "power"

  pure fn square value: Float -> Float
  pure fn cube value: Float -> Float
  pure fn reciprocal value: Float -> Float
  pure fn squareRoot value: Float -> Float
  pure fn cubeRoot value: Float -> Float
  pure fn exponential value: Float -> Float
  pure fn tenPower value: Float -> Float
  pure fn naturalLog value: Float -> Float
  pure fn log10 value: Float -> Float
  pure fn factorial value: Float -> Float

  pure fn sineRadians value: Float -> Float
  pure fn cosineRadians value: Float -> Float
  pure fn tangentRadians value: Float -> Float
  pure fn sineDegrees value: Float -> Float
  pure fn cosineDegrees value: Float -> Float
  pure fn tangentDegrees value: Float -> Float
  pure fn sinh value: Float -> Float
  pure fn cosh value: Float -> Float
  pure fn tanh value: Float -> Float
  pure fn euler unit: Unit -> Float
  pure fn pi unit: Unit -> Float
}

pub fn binarySymbol operator: BinaryOperator -> String =
  match operator {
    Add -> "+"
    Subtract -> "−"
    Multiply -> "×"
    Divide -> "÷"
    Power -> "^"
  }

pub fn evaluateBinary operator: BinaryOperator
  -> left: Float
  -> right: Float
  -> Float =
  match operator {
    Add -> floatAdd left right
    Subtract -> floatSubtract left right
    Multiply -> floatMultiply left right
    Divide -> floatDivide left right
    Power -> floatPower left right
  }

fn sine unit: AngleUnit -> value: Float -> Float =
  match unit {
    Radians -> sineRadians value
    Degrees -> sineDegrees value
  }

fn cosine unit: AngleUnit -> value: Float -> Float =
  match unit {
    Radians -> cosineRadians value
    Degrees -> cosineDegrees value
  }

fn tangent unit: AngleUnit -> value: Float -> Float =
  match unit {
    Radians -> tangentRadians value
    Degrees -> tangentDegrees value
  }

pub fn evaluateUnary unit: AngleUnit
  -> operator: UnaryOperator
  -> value: Float
  -> Float =
  match operator {
    Square -> square value
    Cube -> cube value
    Reciprocal -> reciprocal value
    SquareRoot -> squareRoot value
    CubeRoot -> cubeRoot value
    Exponential -> exponential value
    TenPower -> tenPower value
    NaturalLog -> naturalLog value
    Log10 -> log10 value
    Factorial -> factorial value
    Sine -> sine unit value
    Cosine -> cosine unit value
    Tangent -> tangent unit value
    Sinh -> sinh value
    Cosh -> cosh value
    Tanh -> tanh value
    Euler -> euler ()
    Pi -> pi ()
  }

pub fn unaryExpression operator: UnaryOperator -> operand: String -> String =
  match operator {
    Square -> `(${operand})²`
    Cube -> `(${operand})³`
    Reciprocal -> `1/(${operand})`
    SquareRoot -> `√(${operand})`
    CubeRoot -> `∛(${operand})`
    Exponential -> `e^(${operand})`
    TenPower -> `10^(${operand})`
    NaturalLog -> `ln(${operand})`
    Log10 -> `log(${operand})`
    Factorial -> `(${operand})!`
    Sine -> `sin(${operand})`
    Cosine -> `cos(${operand})`
    Tangent -> `tan(${operand})`
    Sinh -> `sinh(${operand})`
    Cosh -> `cosh(${operand})`
    Tanh -> `tanh(${operand})`
    Euler -> "e"
    Pi -> "π"
  }
