import * as host from "./host"
import {
  Add,
  AngleUnit,
  BinaryOperator,
  Cosine,
  Cosh,
  Cube,
  CubeRoot,
  Degrees,
  Divide,
  Euler,
  Exponential,
  Factorial,
  Log10,
  Multiply,
  NaturalLog,
  Pi,
  Power,
  Radians,
  Reciprocal,
  Sine,
  Sinh,
  Square,
  SquareRoot,
  Subtract,
  Tangent,
  Tanh,
  TenPower,
  UnaryOperator,
} from "./model"

pub fn binarySymbol operator: BinaryOperator -> String =
  match operator {
    Add -> "+"
    Subtract -> "−"
    Multiply -> "×"
    Divide -> "÷"
    Power -> "^"
  }

pub fn evaluateBinary operator: BinaryOperator
  -> left: Float
  -> right: Float
  -> Float =
  match operator {
    Add -> host.floatAdd left right
    Subtract -> host.floatSubtract left right
    Multiply -> host.floatMultiply left right
    Divide -> host.floatDivide left right
    Power -> host.floatPower left right
  }

fn sine unit: AngleUnit -> value: Float -> Float =
  match unit {
    Radians -> host.sineRadians value
    Degrees -> host.sineDegrees value
  }

fn cosine unit: AngleUnit -> value: Float -> Float =
  match unit {
    Radians -> host.cosineRadians value
    Degrees -> host.cosineDegrees value
  }

fn tangent unit: AngleUnit -> value: Float -> Float =
  match unit {
    Radians -> host.tangentRadians value
    Degrees -> host.tangentDegrees value
  }

pub fn evaluateUnary unit: AngleUnit
  -> operator: UnaryOperator
  -> value: Float
  -> Float =
  match operator {
    Square -> host.square value
    Cube -> host.cube value
    Reciprocal -> host.reciprocal value
    SquareRoot -> host.squareRoot value
    CubeRoot -> host.cubeRoot value
    Exponential -> host.exponential value
    TenPower -> host.tenPower value
    NaturalLog -> host.naturalLog value
    Log10 -> host.log10 value
    Factorial -> host.factorial value
    Sine -> sine unit value
    Cosine -> cosine unit value
    Tangent -> tangent unit value
    Sinh -> host.sinh value
    Cosh -> host.cosh value
    Tanh -> host.tanh value
    Euler -> host.euler ()
    Pi -> host.pi ()
  }

pub fn unaryExpression operator: UnaryOperator -> operand: String -> String =
  match operator {
    Square -> `(${operand})²`
    Cube -> `(${operand})³`
    Reciprocal -> `1/(${operand})`
    SquareRoot -> `√(${operand})`
    CubeRoot -> `∛(${operand})`
    Exponential -> `e^(${operand})`
    TenPower -> `10^(${operand})`
    NaturalLog -> `ln(${operand})`
    Log10 -> `log(${operand})`
    Factorial -> `(${operand})!`
    Sine -> `sin(${operand})`
    Cosine -> `cos(${operand})`
    Tangent -> `tan(${operand})`
    Sinh -> `sinh(${operand})`
    Cosh -> `cosh(${operand})`
    Tanh -> `tanh(${operand})`
    Euler -> "e"
    Pi -> "π"
  }
