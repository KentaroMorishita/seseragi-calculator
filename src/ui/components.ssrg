import * as html from "std/web/html"
import * as styles from "./styles"
import { KeyTone } from "./styles"

pub fn iconButton label: String
  -> history: Bool
  -> action: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: action,
    style: styles.iconButtonStyle history,
    children: label,
  }

pub fn toolbar openHistory: Task<Unit>
  -> openModeMenu: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.header {
    style: styles.toolbarStyle (),
    children: [
      iconButton "◷" True openHistory,
      iconButton "ƒx" False openModeMenu,
    ],
  }

fn captionView caption: String -> html.Html<Task<Unit>> =
  html.div {
    style: styles.captionStyle (),
    children: caption,
  }

fn valueView value: String
  -> valueWidth: Int
  -> scientific: Bool
  -> html.Html<Task<Unit>> =
  html.p {
    style: styles.valueStyle scientific valueWidth,
    children: value,
  }

pub fn display caption: String
  -> value: String
  -> valueWidth: Int
  -> scientific: Bool
  -> html.Html<Task<Unit>> =
  html.section {
    style: styles.displayAreaStyle scientific,
    children: [captionView caption, valueView value valueWidth scientific],
  }

pub fn keyButton label: String
  -> tone: KeyTone
  -> compact: Bool
  -> action: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: action,
    style: styles.keyButtonStyle tone compact,
    children: label,
  }

pub fn scientificButton label: String
  -> action: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: action,
    style: styles.scientificButtonStyle (),
    children: label,
  }
