import * as html from "std/web/html"

pub type KeyTone =
  | NumberKey
  | UtilityKey
  | OperatorKey

fn keyBackground tone: KeyTone -> String =
  match tone {
    NumberKey -> "#333333"
    UtilityKey -> "#6b6b6d"
    OperatorKey -> "#ff9500"
  }

fn keySize compact: Bool -> String =
  if compact then
    "clamp(48px, min(13vw, 7.4dvh), 56px)"
  else
    "clamp(62px, min(18vw, 9.4dvh), 82px)"

fn displayFontSize scientific: Bool -> valueWidth: Int -> String =
  if scientific then
    if valueWidth <= 6 then "64px"
    else if valueWidth <= 9 then "54px"
    else if valueWidth <= 12 then "46px"
    else if valueWidth <= 15 then "38px"
    else "32px"
  else
    if valueWidth <= 6 then "clamp(68px, 22vw, 96px)"
    else if valueWidth <= 9 then "clamp(58px, 18vw, 80px)"
    else if valueWidth <= 12 then "clamp(48px, 15vw, 68px)"
    else if valueWidth <= 15 then "clamp(40px, 12vw, 54px)"
    else if valueWidth <= 18 then "clamp(34px, 10vw, 46px)"
    else "32px"

pub fn pageStyle -> html.Style =
  html.style {
    backgroundColor: "#000000",
    color: "#ffffff",
    fontFamily: "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif",
    height: "100dvh",
    margin: "0",
    minHeight: "0",
    overflow: "hidden",
    width: "100%",
  }

pub fn shellStyle -> html.Style =
  html.style {
    backgroundColor: "#000000",
    boxSizing: "border-box",
    display: "flex",
    flexDirection: "column",
    height: "100dvh",
    marginLeft: "auto",
    marginRight: "auto",
    maxWidth: "460px",
    minHeight: "0",
    overflow: "hidden",
    padding: "14px 16px 16px",
    position: "relative",
    width: "100%",
  }

pub fn toolbarStyle -> html.Style =
  html.style {
    alignItems: "center",
    display: "flex",
    flexShrink: "0",
    justifyContent: "space-between",
    minHeight: "54px",
  }

pub fn iconButtonStyle history: Bool -> html.Style =
  html.style {
    alignItems: "center",
    backgroundColor: "#1c1c1e",
    border: "1px solid #333336",
    borderRadius: "999px",
    color: "#f5f5f7",
    display: "flex",
    fontFamily: "inherit",
    fontSize: "22px",
    height: "48px",
    justifyContent: "center",
    lineHeight: "1",
    padding: "0",
    paddingBottom: if history then "2px" else "0",
    textAlign: "center",
    width: "48px",
  }

pub fn displayAreaStyle scientific: Bool -> html.Style =
  html.style {
    alignItems: "flex-end",
    display: "flex",
    flexDirection: "column",
    flexGrow: "1",
    justifyContent: "flex-end",
    minHeight: "0",
    overflow: "hidden",
    paddingBottom: if scientific then "8px" else "16px",
    paddingLeft: "4px",
    paddingRight: "4px",
  }

pub fn captionStyle -> html.Style =
  html.style {
    color: "#6f6f73",
    fontSize: "20px",
    minHeight: "28px",
    overflow: "hidden",
    textAlign: "right",
    textOverflow: "ellipsis",
    whiteSpace: "nowrap",
    width: "100%",
  }

pub fn valueStyle scientific: Bool -> valueWidth: Int -> html.Style =
  html.style {
    color: "#ffffff",
    fontSize: displayFontSize scientific valueWidth,
    fontVariantNumeric: "tabular-nums",
    fontWeight: "300",
    letterSpacing: "-0.04em",
    lineHeight: "1",
    margin: "4px 0 0",
    overflow: "hidden",
    textAlign: "right",
    whiteSpace: "nowrap",
    width: "100%",
  }

pub fn basicGridStyle scientific: Bool -> html.Style =
  html.style {
    display: "grid",
    flexShrink: "0",
    gap: if scientific then "8px" else "10px",
    gridTemplateColumns: "repeat(4, minmax(0, 1fr))",
  }

pub fn scientificGridStyle -> html.Style =
  html.style {
    display: "grid",
    flexShrink: "0",
    gap: "7px",
    gridTemplateColumns: "repeat(5, minmax(0, 1fr))",
    marginBottom: "10px",
  }

pub fn keyButtonStyle tone: KeyTone -> compact: Bool -> html.Style =
  html.style {
    alignItems: "center",
    backgroundColor: keyBackground tone,
    border: "0",
    borderRadius: "999px",
    color: "#ffffff",
    display: "flex",
    fontFamily: "inherit",
    fontSize: if compact then "20px" else "clamp(30px, 8vw, 36px)",
    fontWeight: "400",
    height: keySize compact,
    justifyContent: "center",
    lineHeight: "1",
    marginLeft: "auto",
    marginRight: "auto",
    padding: "0",
    width: keySize compact,
  }

pub fn scientificButtonStyle -> html.Style =
  html.style {
    alignItems: "center",
    backgroundColor: "#1c1c1e",
    border: "1px solid #303033",
    borderRadius: "20px",
    color: "#f5f5f7",
    display: "flex",
    fontFamily: "inherit",
    fontSize: "16px",
    height: "clamp(38px, 6dvh, 46px)",
    justifyContent: "center",
    lineHeight: "1",
    padding: "0",
    width: "100%",
  }

