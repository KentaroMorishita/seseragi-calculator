import * as html from "std/web/html"
import * as components from "./components"
import * as styles from "./styles"
import {
  KeyTone,
  NumberKey,
  OperatorKey,
  UtilityKey,
} from "./styles"

pub alias BasicActions = {
  digit: (Int -> Task<Unit>),
  decimalPoint: Task<Unit>,
  backspace: Task<Unit>,
  clear: Task<Unit>,
  percent: Task<Unit>,
  divide: Task<Unit>,
  multiply: Task<Unit>,
  subtract: Task<Unit>,
  add: Task<Unit>,
  toggleSign: Task<Unit>,
  equals: Task<Unit>,
}

pub alias ScientificButton = {
  label: String,
  action: Task<Unit>,
}

fn key label: String
  -> tone: KeyTone
  -> compact: Bool
  -> action: Task<Unit>
  -> html.Html<Task<Unit>> =
  components.keyButton label tone compact action

pub fn basicKeypad compact: Bool
  -> actions: BasicActions
  -> html.Html<Task<Unit>> =
  html.section {
    style: styles.basicGridStyle compact,
    children: [
      key "⌫" UtilityKey compact actions.backspace,
      key "AC" UtilityKey compact actions.clear,
      key "%" UtilityKey compact actions.percent,
      key "÷" OperatorKey compact actions.divide,

      key "7" NumberKey compact (actions.digit 7),
      key "8" NumberKey compact (actions.digit 8),
      key "9" NumberKey compact (actions.digit 9),
      key "×" OperatorKey compact actions.multiply,

      key "4" NumberKey compact (actions.digit 4),
      key "5" NumberKey compact (actions.digit 5),
      key "6" NumberKey compact (actions.digit 6),
      key "−" OperatorKey compact actions.subtract,

      key "1" NumberKey compact (actions.digit 1),
      key "2" NumberKey compact (actions.digit 2),
      key "3" NumberKey compact (actions.digit 3),
      key "+" OperatorKey compact actions.add,

      key "±" NumberKey compact actions.toggleSign,
      key "0" NumberKey compact (actions.digit 0),
      key "." NumberKey compact actions.decimalPoint,
      key "=" OperatorKey compact actions.equals,
    ],
  }

fn scientificKey button: ScientificButton -> html.Html<Task<Unit>> =
  components.scientificButton button.label button.action

pub fn scientificKeypad buttons: Array<ScientificButton>
  -> html.Html<Task<Unit>> =
  html.section {
    style: styles.scientificGridStyle (),
    children: [scientificKey button | button <- buttons],
  }
