import * as arrays from "std/array"
import * as html from "std/web/html"
import {
  Basic,
  CalculatorAction,
  CalculatorMode,
  CloseOverlay,
  HistoryEntry,
  RecallHistory,
  Scientific,
  SelectMode,
} from "../calculator/model"
import * as styles from "./styles"

fn modeSelected target: CalculatorMode -> current: CalculatorMode -> Bool =
  match target {
    Basic ->
      match current {
        Basic -> True
        Scientific -> False
      }
    Scientific ->
      match current {
        Basic -> False
        Scientific -> True
      }
  }

fn modeOption label: String
  -> target: CalculatorMode
  -> current: CalculatorMode
  -> send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: send (SelectMode target),
    style: styles.menuButtonStyle (modeSelected target current),
    children:
      if modeSelected target current then
        `✓  ${label}`
      else
        `   ${label}`,
  }

pub fn modeMenu current: CalculatorMode
  -> send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  html.div {
    style: styles.modeMenuStyle (),
    children: [
      modeOption "Basic" Basic current send,
      modeOption "Scientific" Scientific current send,
    ],
  }

fn historyExpression value: String -> html.Html<Task<Unit>> =
  html.p {
    style: styles.historyExpressionStyle (),
    children: value,
  }

fn historyResult value: String -> html.Html<Task<Unit>> =
  html.p {
    style: styles.historyResultStyle (),
    children: value,
  }

fn historyItem send: (CalculatorAction -> Task<Unit>)
  -> item: HistoryEntry
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: send (RecallHistory item.value),
    style: styles.historyItemStyle (),
    children: [
      historyExpression item.expression,
      historyResult item.result,
    ],
  }

fn emptyHistory -> html.Html<Task<Unit>> =
  html.div {
    style: styles.emptyHistoryStyle (),
    children: "No calculations yet",
  }

fn historyItems entries: Array<HistoryEntry>
  -> send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  if arrays.isEmpty entries then
    emptyHistory ()
  else
    html.div {
      children: [
        historyItem send item
        | item <- arrays.take 8 (arrays.reverse entries)
      ],
    }

fn sheetTitle -> html.Html<Task<Unit>> =
  html.h2 {
    style: styles.sheetTitleStyle (),
    children: "History",
  }

fn closeButton send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: send CloseOverlay,
    style: styles.closeButtonStyle (),
    children: "×",
  }

fn sheetHeader send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  html.header {
    style: styles.sheetHeaderStyle (),
    children: [sheetTitle (), closeButton send],
  }

fn historyPanel entries: Array<HistoryEntry>
  -> send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  html.section {
    style: styles.historySheetStyle (),
    children: [sheetHeader send, historyItems entries send],
  }

pub fn historySheet entries: Array<HistoryEntry>
  -> send: (CalculatorAction -> Task<Unit>)
  -> html.Html<Task<Unit>> =
  html.div {
    style: styles.sheetLayerStyle (),
    children: historyPanel entries send,
  }
